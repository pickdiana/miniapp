<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#130e20">
    <title>Catalog | Mini App</title>
    <link rel="stylesheet" href="assets/cache/site.9814d2968467c61d.css">
    <link rel="stylesheet" href="assets/cache/catalog.dc7e5c848e7fc8e4.css">
</head>
<body id="top">
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="./">
                <span class="brand-name" id="brand-title">CATALOG</span>
            </a>
        </div>
    </header>

    <main id="main">
        <section class="catalog container">
            <div class="catalog-controls" id="collection">
                <div class="catalog-toolbar">
                    <nav class="category-nav" id="category-nav">
                        <!-- Las categorías se cargan solas -->
                    </nav>
                    <span class="product-count" id="product-count" role="status">0 pieces</span>
                </div>
            </div>

            <!-- Grilla de productos dinámica -->
            <div class="product-grid" id="products">
                <!-- Los productos se inyectan aquí automáticamente -->
            </div>
        </section>
    </main>

    <a class="support-link" id="support-link" href="#" target="_blank" rel="noopener noreferrer">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M21.5 3.3 18.3 20c-.2 1.1-.9 1.3-1.8.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.3L6.1 13.6l-4.8-1.5c-1-.3-1-1 .2-1.4L20.2 3c.8-.3 1.5.2 1.3.3Z"></path></svg>
        <span class="support-tooltip">Support</span>
    </a>

    <script src="app.js" defer></script>
</body>
</html>
